{\rtf1\ansi\deff0{\fonttbl{\f0\fmodern Courier;}}\f0\fs18 \line\b --- FILE: anon_hash.R ---\b0\line #' Clean and Standardize Email Strings\line #' @description Prepares email addresses for hashing by removing whitespace\line #' and normalizing case.\line #' @param x A character vector of email addresses.\line #' @return A standardized character vector.\line anon_clean_email <- function(x) \{\line   if (is.null(x)) return(NULL)\line \line   # Standardize: trim whitespace and lowercase\line   clean_x <- trimws(tolower(as.character(x)))\line \line   # Ensure NAs are preserved as NA_character_ to avoid hashing the string "NA"\line   clean_x[is.na(x) | x == ""] <- NA_character_\line \line   return(clean_x)\line \}\line \line #' Generate Readable Research IDs via Salted Hashing\line #' @description Creates a 12-character SHA-256 hash from an identifier and\line #' a project-specific salt.\line #' @param x A character vector of identifiers (e.g., cleaned emails).\line #' @return A truncated 12-character hex string vector.\line anon_hash <- function(x) \{\line \line   # 1. Environment Gate: Retrieve Salt\line   # Option A: Salt managed via .Renviron for security and reproducibility\line   salt_key <- Sys.getenv("HARMONIZE_SALT")\line \line   # Fail-Fast: Do not allow insecure defaults\line   if (salt_key == "") \{\line     cli::cli_abort(c(\line       "x" = "Security Error: No \{.var HARMONIZE_SALT\} found in environment.",\line       "i" = "Please set a salt in your \{.file .Renviron\} file: \{.code HARMONIZE_SALT='your_secret_key'\}",\line       "!" = "Execution halted to prevent insecure de-identification."\line     ))\line   \}\line \line   # 2. Hashing Execution\line   # We use SHA-256 via the digest package as it is the current research standard\line   hashed_values <- vapply(x, function(val) \{\line     if (is.na(val)) return(NA_character_)\line \line     # Concatenate value with salt before hashing\line     full_hash <- digest::digest(paste0(val, salt_key), algo = "sha256")\line \line     # 3. Formatting: Truncate to 12 characters for readability as requested\line     substr(full_hash, 1, 12)\line   \}, character(1), USE.NAMES = FALSE)\line \line   return(hashed_values)\line \}\line \line \line\b --- FILE: detect_factor_potential.R ---\b0\line detect_factor_potential <- function(x) \{\line   # 1. Pre-processing: Isolate non-missing data for logic checks\line   # We work on 'x_clean' to calculate metrics, but return original 'x' (or version of it)\line   x_clean <- x[!is.na(x)]\line   n_total <- length(x_clean)\line \line   # Edge case: If vector is empty or all NA, return original class\line   if (n_total == 0) return(x)\line \line   # Calculate Key Metrics\line   unique_vals <- unique(x_clean)\line   n_unique    <- length(unique_vals)\line \line   # -------------------------------------------------------\line   # STRATEGY 1: The 'Likert/Binary' Bypass\line   # -------------------------------------------------------\line   # If cardinality is very low, it's likely a factor (e.g., Yes/No, 1-5 scales)\line   # regardless of sample size.\line   if (n_unique <= 5) \{\line     return(as.factor(x))\line   \}\line \line   # -------------------------------------------------------\line   # STRATEGY 2: The 'Pattern' Test (Strict Filters)\line   # -------------------------------------------------------\line   # If it failed the bypass, it must pass ALL three rigorous checks\line   # to be considered a factor.\line \line   # Condition A: Cardinality Cap\line   # Rejects continuous variables (e.g., Age 18-99 has too many levels)\line   is_low_cardinality <- n_unique <= 16\line \line   # Condition B: Sample Size Floor\line   # We need enough data to distinguish a distribution from noise\line   is_large_sample <- n_total >= 20\line \line   # Condition C: Repetition Rule\line   # Distinguishes factors (groups) from IDs (unique values).\line   # Logic: A true factor should have categories that repeat.\line   # We require 20% of the categories to appear at least 3 times.\line   freq_counts <- table(x_clean)\line   n_repeats   <- sum(freq_counts >= 3)\line   rep_ratio   <- n_repeats / n_unique\line \line   is_repetitive <- rep_ratio >= 0.20\line \line   # FINAL DECISION: All strict conditions must be TRUE\line   if (is_low_cardinality && is_large_sample && is_repetitive) \{\line     return(as.factor(x))\line   \} else \{\line     return(x)\line   \}\line \}\line \line \line\b --- FILE: dict_init.R ---\b0\line # NOTE: Module A Update (Added 'match_by' logic)\line # NOTE: Dependencies: openxlsx, dplyr, purrr, janitor, cli\line \line #' Initialize Data Dictionary\line #' @param data_list Named list of dataframes.\line #' @param match_by Character. "name" matches by variable name. "position"  (default) matches by column index (risky but good for translations).\line #' @param type_prefix Character prefix for target names.\line #' @param save_path Path to output .xlsx.\line dict_init <- function(data_list, match_by = "position",\line                       type_prefix = "var", save_path = "dictionary.xlsx") \{\line \line   # 1. SETUP & VALIDATION\line   match_by <- match.arg(match_by)\line \line   if (!is.list(data_list) || length(data_list) == 0) \{\line     cli::cli_abort("Input \{.arg data_list\} must be a non-empty list of data frames.")\line   \}\line   if (file.exists(save_path)) \{\line     cli::cli_alert_warning("File \{.file \{save_path\}\} already exists. Overwriting...")\line   \}\line \line   # 2. SANITIZATION\line   cli::cli_alert_info("Sanitizing input names (janitor::clean_names)...")\line   clean_list <- list()\line   for (n in names(data_list)) \{\line     clean_list[[n]] <- janitor::clean_names(data_list[[n]])\line   \}\line \line   # 3. BUILD WIDE MAP\line   cli::cli_alert_info("Building map using strategy: \{.strong \{match_by\}\}")\line \line   if (match_by == "name") \{\line     # --- STRATEGY A: MATCH BY NAME (Alphabetical) ---\line     all_vars_list <- lapply(clean_list, names)\line     unique_vars <- sort(unique(unlist(all_vars_list)))\line \line     wide_map <- data.frame(\line       target_name = paste0(type_prefix, "_", sprintf("%03d", seq_along(unique_vars))),\line       description = NA_character_,\line       stringsAsFactors = FALSE\line     )\line \line     for (wave_name in names(clean_list)) \{\line       col_name <- paste0("orig_", tolower(wave_name))\line       is_present <- unique_vars %in% names(clean_list[[wave_name]])\line       wide_map[[col_name]] <- ifelse(is_present, unique_vars, NA_character_)\line     \}\line \line   \} else \{\line     # --- STRATEGY B: MATCH BY POSITION (Structural) ---\line     # This aligns Col 1 of W1 with Col 1 of W2.\line     # Crucial for multi-language questionnaires.\line \line     max_cols <- max(vapply(clean_list, ncol, integer(1)))\line \line     wide_map <- data.frame(\line       target_name = paste0(type_prefix, "_", sprintf("%03d", 1:max_cols)),\line       description = NA_character_,\line       stringsAsFactors = FALSE\line     )\line \line     for (wave_name in names(clean_list)) \{\line       col_name <- paste0("orig_", tolower(wave_name))\line       current_names <- names(clean_list[[wave_name]])\line \line       # Pad with NA if this wave has fewer columns than the max\line       length(current_names) <- max_cols\line       wide_map[[col_name]] <- current_names\line     \}\line   \}\line \line   # 4. FACTOR MINING\line   factor_rows <- list()\line   # Start at Row 2 (Row 1 is header)\line   current_row_idx <- 2\line \line   for (nm in names(clean_list)) \{\line     df <- clean_list[[nm]]\line     # Detect factors\line     vars <- names(df)[vapply(df, function(x) is.factor(detect_factor_potential(x)), logical(1))]\line \line     if (length(vars) > 0) \{\line       # Identify the column letter in Wide Map for this wave\line       # We use 'wide_map' structure to find the index\line       wave_col_name <- paste0("orig_", tolower(nm))\line       target_col_idx <- which(names(wide_map) == wave_col_name)\line       col_letter <- openxlsx::int2col(target_col_idx) # e.g., "C", "D"\line \line       for (v in vars) \{\line         vals <- sort(unique(df[[v]]))\line         n <- length(vals)\line \line         factor_rows[[length(factor_rows) + 1]] <- data.frame(\line           wave = wave_col_name,\line           original_variable = v,\line           target_name = NA, # The Formula String\line           original_level = as.character(vals),\line           standard_code = seq_along(vals),\line           standard_label = as.character(vals),\line           stringsAsFactors = FALSE\line         )\line         current_row_idx <- current_row_idx + n\line       \}\line     \}\line   \}\line \line   factor_map <- dplyr::bind_rows(factor_rows)\line \line \line   # 5. EXCEL GENERATION\line   wb <- openxlsx::createWorkbook()\line   header_style <- openxlsx::createStyle(textDecoration = "bold", border = "Bottom")\line \line   # Instructions\line   instr_text <- c(\line     "SHEET: Variable_Map_Wide",\line     "This sheet is used to modify the variables to harmonize. You need to review that equivalent variables in data versions are set in the same row and are given the same 'target_name'. 'target_name's can be modified as needed. The order can be changed as well. Variables unwanted in the harmonized data can be dropped. A 'version 0' of the initial metadata is saved in the sheet 'Original:Metadata'.",\line     if(match_by == "position") \{\line     "CAUTION: Variables aligned by COLUMN POSITION. Verify that 'orig_w1' and 'orig_w2' actually correspond."\line   \} else \{\line     "Variables aligned by NAME. Merging different languages may require manual row moves."\line   \},\line   "",\line   "SHEET: Factor_Levels",\line     "Column C (target_name) is calculated automatically from target_name in 'Variable_Map_Wide'. Requires Excel 2021/365.",\line   "LEGACY FIX: If showing #NAME?, replace formula with VLOOKUP, i.e. (european standard):",\line   "=IFERROR(INDEX('Variable_Map_Wide'!$A:$A; MATCH(B2; 'Variable_Map_Wide'!$C:$C; 0)); INDEX('Variable_Map_Wide'!$A:$A; MATCH(B2; 'Variable_Map_Wide'!$D:$D; 0)))",\line   "",\line     "SHEET: Original_Metadata",\line     "This sheet is only meant to leave a registry of the original structure of the data. Not for harmonization purposes. "\line   )\line   # --- Sheet: Instructions ---\line   openxlsx::addWorksheet(wb, "Instructions")\line   openxlsx::writeData(wb, "Instructions", x = instr_text, startCol = 1, startRow = 1)\line \line   # --- Sheet: Variable_Map_Wide ---\line   openxlsx::addWorksheet(wb, "Variable_Map_Wide")\line   openxlsx::writeData(wb, "Variable_Map_Wide", wide_map)\line   openxlsx::addStyle(wb, "Variable_Map_Wide", header_style, rows = 1, cols = 1:ncol(wide_map))\line   openxlsx::freezePane(wb, "Variable_Map_Wide", firstCol = TRUE)\line \line   # --- Sheet: Factor Levels ---\line   openxlsx::addWorksheet(wb, "Factor_Levels")\line \line   if(nrow(factor_map) == 0)\{\line     openxlsx::writeData(wb, "Factor_Levels", "No factors found")\line   \} else \{\line     openxlsx::writeDataTable(wb, "Factor_Levels",\line                                x = factor_map,\line                                tableName = "Table_Factors",\line                                tableStyle = "TableStyleMedium2")\line \line   # Embed FORMULAS with =XLOOKUP\line   n_meta_rows <- nrow(wide_map) + 1 # Variable map range\line \line   # Create function arguments\line   lookup_array_refC <- sprintf("'%s'!$C$2:$C$%d", "Variable_Map_Wide", n_meta_rows)\line   lookup_array_refD <- sprintf("'%s'!$D$2:$D$%d", "Variable_Map_Wide", n_meta_rows)\line   return_array_ref <- sprintf("'%s'!$A$2:$A$%d", "Variable_Map_Wide", n_meta_rows)\line   n_data_rows <- (n_meta_rows-1) * 2\line   data_row_indices <- 2:(n_data_rows + 1)\line \line   formula_vec <- paste0(\line     "_xlfn.IFNA(",\line     "_xlfn.XLOOKUP(",\line     "B", data_row_indices, ", ",\line     lookup_array_refC, ", ",\line     return_array_ref,\line     "), ",\line     "_xlfn.XLOOKUP(",\line     "B", data_row_indices, ", ",\line     lookup_array_refD, ", ",\line     return_array_ref,\line     "))"\line   )\line   # Write formula into table\line     writeFormula(\line       wb,\line       sheet = "Factor_Levels",\line       x = formula_vec,\line       startCol = 3,\line       startRow = 2)\line   \}\line \line   # --- Sheet: Change Log ---\line   openxlsx::addWorksheet(wb, "Change_Log")\line   openxlsx::writeData(wb, "Change_Log", data.frame(timestamp = as.character(Sys.time()), action = "INIT", match_strategy = match_by))\line \line   # --- Sheet: Original_Metadata ---\line   openxlsx::addWorksheet(wb, "Original_Metadata")\line   openxlsx::writeData(wb, "Original_Metadata", wide_map)\line \line   # --- SSave Workbook ---\line   openxlsx::saveWorkbook(wb, save_path, overwrite = TRUE)\line   cli::cli_alert_success("Dictionary initialized at \{.file \{save_path\}\}")\line \line   return(invisible(TRUE))\line \}\line \line \line \line\b --- FILE: dict_validate.R ---\b0\line # NOTE: This is Step 1 (Logic Only). No Roxygen yet.\line # NOTE: Dependencies: readxl, cli, stringr, dplyr\line \line dict_validate <- function(path) \{\line \line   # 1. FAIL FAST: File Existence --------------------------------------------\line   if (!file.exists(path)) \{\line     cli::cli_abort("Dictionary file not found: \{.file \{path\}\}")\line   \}\line \line   cli::cli_alert_info("Validating dictionary structure...")\line \line   # 2. SHEET CHECK ----------------------------------------------------------\line   sheets <- readxl::excel_sheets(path)\line   required <- c("Variable_Map_Wide", "Factor_Levels")\line   missing <- setdiff(required, sheets)\line \line   if (length(missing) > 0) \{\line     cli::cli_abort("Missing critical sheets: \{.val \{missing\}\}")\line   \}\line \line   # 3. VARIABLE MAP VALIDATION ----------------------------------------------\line   # Read as text to prevent eager type coercion\line   wide_map <- readxl::read_excel(path, sheet = "Variable_Map_Wide", col_types = "text")\line \line   # Enforce lowercase headers\line   names(wide_map) <- tolower(names(wide_map))\line \line   if (!"target_name" %in% names(wide_map)) \{\line     cli::cli_abort("Sheet 'Variable_Map_Wide' is missing the \{.var target_name\} column.")\line   \}\line \line   # Check for Duplicates (Critical for Primary Keys)\line   # We filter out NAs because sometimes users leave empty rows for spacing\line   targets <- wide_map$target_name[!is.na(wide_map$target_name)]\line \line   if (any(duplicated(targets))) \{\line     dupes <- unique(targets[duplicated(targets)])\line     cli::cli_abort(c(\line       "Duplicate \{.var target_name\} detected.",\line       "x" = "Concepts must be unique: \{.val \{dupes\}\}"\line     ))\line   \}\line \line   # Check for "snake_case" compliance in target_name\line   # Regex: starts with letter, only contains letters, numbers, underscores\line   bad_names <- targets[!stringr::str_detect(targets, "^[a-z][a-z0-9_]*$")]\line   if (length(bad_names) > 0) \{\line     cli::cli_alert_danger("The following target_names violate 'snake_case' rules:")\line     cli::cli_ul(head(bad_names, 5))\line     cli::cli_abort("All target_names must be lowercase, no spaces, no special chars.")\line   \}\line \line   # 4. FACTOR MAP VALIDATION ------------------------------------------------\line   f_map <- readxl::read_excel(path, sheet = "Factor_Levels")\line   names(f_map) <- tolower(names(f_map))\line \line   if(names(f_map)[1] == "no factors found")\{\line     cli::cli_alert_danger("No factors found in dataset. Skipping review. ")\line   \} else \{\line \line \line   req_cols <- c("target_name", "standard_code", "standard_label")\line   missing_f <- setdiff(req_cols, names(f_map))\line \line   if (length(missing_f) > 0) \{\line     cli::cli_abort("Sheet 'Factor_Levels' missing columns: \{.val \{missing_f\}\}")\line   \}\line \line   # Ensure standard_code is numeric\line   # readxl might have read it as text if there were typos.\line   if (!is.numeric(f_map$standard_code)) \{\line     # Try to coerce\line     coerced <- suppressWarnings(as.numeric(f_map$standard_code))\line     if (any(is.na(coerced) & !is.na(f_map$standard_code))) \{\line       cli::cli_abort("Column \{.var standard_code\} contains non-numeric values. It must be strictly integers.")\line     \}\line   \}\line \line   # Orphan Check: Factor targets that don't exist in Wide Map\line   orphans <- setdiff(unique(f_map$target_name), unique(wide_map$target_name))\line   if (length(orphans) > 0) \{\line     cli::cli_alert_warning("Found \{length(orphans)\} orphaned factor definitions (not in Wide Map). They will be ignored.")\line   \}\line  \}\line \line   cli::cli_alert_success("Dictionary \{.file \{basename(path)\}\} passed validation.")\line   return(invisible(TRUE))\line \}\line \line \line\b --- FILE: harm_add_timepoint.R ---\b0\line #' Append a New Longitudinal Timepoint\line #'\line #' @description Safely joins a new wave of data to an existing master dataset.\line #' It automatically handles variable renaming (suffixing) to prevent collisions\line #' and uses a full join to preserve all participants (attrition + recruitment).\line #'\line #' @param master_data A data.frame/tibble representing the current master dataset (Time 1..N).\line #' @param new_data A data.frame/tibble representing the new timepoint (Time N+1).\line #'                 Must be already processed by dict_apply().\line #' @param by_id Character. The name of the distinct variable to join by (e.g., "participant_id").\line #'              Must exist in both datasets.\line #' @param suffix Character. The suffix to append to new variables (e.g., "_w2", "_t2").\line #'               Must start with an underscore/separator to ensure readability.\line #' @param verbose Logical. If TRUE, prints a summary of the join statistics.\line #'\line #' @return A single wide-format tibble containing both datasets.\line #' @export\line harm_add_timepoint <- function(master_data, new_data, by_id, suffix, verbose = TRUE) \{\line \line   # 1. FAIL FAST: Input Validation ------------------------------------------\line   if (!is.data.frame(master_data) || !is.data.frame(new_data)) \{\line     cli::cli_abort("Inputs \{.arg master_data\} and \{.arg new_data\} must be data frames.")\line   \}\line \line   if (!is.character(by_id) || length(by_id) != 1) \{\line     cli::cli_abort("\{.arg by_id\} must be a single character string.")\line   \}\line \line   if (!by_id %in% names(master_data)) \{\line     cli::cli_abort("ID column \{.val \{by_id\}\} not found in \{.arg master_data\}.")\line   \}\line \line   if (!by_id %in% names(new_data)) \{\line     cli::cli_abort("ID column \{.val \{by_id\}\} not found in \{.arg new_data\}.")\line   \}\line \line   # Check for duplicate IDs in the NEW data (Critical for 1:1 Joining)\line   if (any(duplicated(new_data[[by_id]]))) \{\line     n_dupes <- sum(duplicated(new_data[[by_id]]))\line     cli::cli_abort(c(\line       "x" = "Duplicate IDs detected in \{.arg new_data\}.",\line       "i" = "Found \{n_dupes\} duplicate entries for ID \{.val \{by_id\}\}.",\line       "!" = "Clean or aggregate the new wave before joining."\line     ))\line   \}\line \line   # 2. SUFFIX LOGIC: Isolate the New Wave -----------------------------------\line   # We rename ALL columns in new_data (except the ID)\line   # This prevents 'age.x' and 'age.y' messes.\line \line   # Get all columns except the ID\line   vars_to_rename <- setdiff(names(new_data), by_id)\line \line   if (length(vars_to_rename) == 0) \{\line     cli::cli_warn("\{.arg new_data\} contains only the ID column. Nothing to join.")\line     return(tibble::as_tibble(master_data))\line   \}\line \line   # Apply suffix\line   new_data_renamed <- new_data %>%\line     dplyr::rename_with(\line       .fn = ~ paste0(., suffix),\line       .cols = dplyr::all_of(vars_to_rename)\line     )\line \line   # 3. EXECUTE JOIN: Full Join Strategy -------------------------------------\line   # We use full_join to keep:\line   # - People in Master but missing in New (Attrition)\line   # - People in New but missing in Master (Recruitment)\line \line   combined_data <- dplyr::full_join(master_data, new_data_renamed, by = by_id)\line \line   # 4. AUDIT: Human-in-the-Loop Reporting -----------------------------------\line   if (verbose) \{\line     # Calculate overlap stats\line     ids_master <- master_data[[by_id]]\line     ids_new    <- new_data[[by_id]]\line \line     n_match    <- length(intersect(ids_master, ids_new))\line     n_attrit   <- length(setdiff(ids_master, ids_new)) # Only in Master\line     n_recruit  <- length(setdiff(ids_new, ids_master)) # Only in New\line \line     cli::cli_h2("Longitudinal Join Audit")\line     cli::cli_ul(c(\line       "Matched (Both Waves): \{.val \{n_match\}\}",\line       "Attrition (Master Only): \{.val \{n_attrit\}\}",\line       "Recruitment (New Only): \{.val \{n_recruit\}\}",\line       "Total Participants: \{.val \{nrow(combined_data)\}\}"\line     ))\line \line     if (n_recruit > 0) \{\line       cli::cli_alert_info("New participants added. Check if these are valid new recruits or ID typos.")\line     \}\line   \}\line \line   return(tibble::as_tibble(combined_data))\line \}\line \line \line\b --- FILE: harm_bind_waves.R ---\b0\line #' Apply Dictionary Mapping and Standardize Categorical Values\line #' @description Renames variables based on the Wide Map and converts factor\line #' labels to numeric strings using the Factor Levels.\line #' @param data A data.frame to be standardized.\line #' @param wb_path Path to the Excel dictionary (.xlsx).\line #' @param source_name Dictionary column name containing the metadata of the particular dataset. Case sensitive, must exactly match the spelling in the dictionary. Unless overwritten, will have the form "orig_xxx".\line #' @param attributes Default = FALSE: whether to save as dataframe attributes a vector with original variable names and descriptions, if any\line #' @return A standardized tibble.\line dict_apply <- function(data, wb_path, source_name, attributes = FALSE) \{\line \line   # 1. Initialization and Sanitization\line   # Input is immediately passed through janitor::clean_names\line   data_clean <- janitor::clean_names(data)\line   wave_id <- tolower(source_name)\line \line   # Load mapping sheets using openxlsx for compatibility with existing codebase\line   w_map <- openxlsx::read.xlsx(wb_path, sheet = "Variable_Map_Wide")\line   l_map <- openxlsx::read.xlsx(wb_path, sheet = "Factor_Levels")\line \line   # Force lowercase headers to prevent case-sensitivity crashes\line   colnames(w_map) <- tolower(colnames(w_map))\line   colnames(l_map) <- tolower(colnames(l_map))\line \line   # Find matching ID column in the dictionary\line   wave_col <- intersect(source_name, colnames(w_map))\line   if (!wave_col %in% colnames(w_map)) \{\line     cli::cli_abort("Wave column \{.val \{wave_col\}\} not found in Variable_Map_Wide. Check dictionary, source_name must match either column 3 or 4 in sheet 2")\line   \}\line \line   # 2. Variable Renaming and Subsetting\line   # Extract mapping for variables present in this wave\line   map_sub <- w_map[!is.na(w_map[[wave_col]]), c("target_name", wave_col)]\line \line   # Only keep variables that are explicitly mapped in the dictionary\line   valid_cols <- map_sub[[wave_col]] %in% colnames(data_clean)\line   map_sub <- map_sub[valid_cols, ]\line \line   if (nrow(map_sub) == 0) \{\line     cli::cli_warn("No variables in wave \{.val \{source_name\}\} matched the dictionary.")\line     return(tibble::as_tibble(data_clean))\line   \}\line \line   # Subset and rename in one step\line   data_std <- data_clean[, map_sub[[wave_col]], drop = FALSE]\line   colnames(data_std) <- map_sub$target_name\line \line   # add attributes\line   if(attributes == TRUE)\{\line     attr(data_std, "labels") <- map_sub[[wave_col]]\line     attr(data_std, "descriptions") <- w_map$description[w_map$target_name %in% map_sub$target_name]\line   \}\line \line   # 3. Categorical Transformation (Factor Re-leveling)\line   # Filter the factor map for this specific wave\line   wave_factors <- l_map[l_map$wave == wave_id, ]\line \line   if (nrow(l_map) > 0) \{\line     for (orig_var in unique(wave_factors$original_variable)) \{\line       # Find the target_name associated with this original variable\line       target <- map_sub$target_name[map_sub[[wave_col]] == orig_var]\line \line       if (length(target) > 0 && target %in% colnames(data_std)) \{\line         lev_map <- wave_factors[wave_factors$original_variable == orig_var, ]\line \line         # Mapping: Original Label -> Standard Code (as character string)\line         # This allows cross-language binding by unifying labels to numbers\line         lookup <- stats::setNames(as.character(lev_map$standard_code),\line                                   as.character(lev_map$original_level))\line \line         # Apply the mapping while maintaining the factor class\line         # We use levels defined in the dictionary to ensure a universal baseline\line         data_std[[target]] <- factor(\line           lookup[as.character(data_std[[target]])],\line           levels = unique(as.character(lev_map$standard_code))\line         )\line       \}\line     \}\line   \}\line \line   return(tibble::as_tibble(data_std))\line \}\line \line #' Robustly Bind Harmonized Waves\line #' @description Combines a list of standardized dataframes, handling potential\line #' type mismatches safely.\line #' @param data_list A named list of dataframes already processed by dict_apply.\line #' @return A single harmonized tibble.\line harm_bind_waves <- function(data_list) \{\line \line   if (!is.list(data_list) || length(data_list) == 0) \{\line     cli::cli_abort("Input must be a non-empty list of dataframes.")\line   \}\line \line   # Safety Net: Use the resolve_types logic for any lingering inconsistencies\line   # bind_rows handles the heavy lifting, but we add a 'source_wave' ID\line   combined <- dplyr::bind_rows(data_list, .id = "source_wave")\line \line   # Ensure all variables created are snake_case\line   colnames(combined) <- tolower(colnames(combined))\line \line   return(tibble::as_tibble(combined))\line \}\line \line \line\b --- FILE: id_audit.R ---\b0\line #' Audit IDs for Longitudinal Typos\line #' @description Identifies potential typos in IDs/emails intended for longitudinal\line #' column-binding. Compares IDs across different time points.\line #' @param data_list A list of dataframes containing the ID column.\line #' @param id_col Character. The name of the ID column (e.g., "pk_hash" or "email").\line #' @param wb_path Character. Path to the Excel dictionary.\line #' @param max_dist Numeric. Maximum Levenshtein distance for a typo flag.\line check_id_audit <- function(id_col1, id_col2, wb_path, max_dist = 1) \{\line   # TODO: this function needs rewriting: it makes no sense to compare all e-mails to all e-mails, it's inefficient. i need to compare w2 to w1 and find the matches; and i need support finding the orphan ones.\line   # step 1: find direct matches w2 to w1\line   # step 2: take unmatched w2 and compute distance algorithm against w1\line   # step 3: write into excel file and have user decide\line   # step 4: take user's input of equivalences\line \line #RM: check_id_audit <- function(data_list, id_col, wb_path, max_dist = 1) \{\line \line   matched <- id_col2 %in% id_col1\line \line \line   # 1. Collect unique IDs across all longitudinal time points\line   all_ids <- c(unique(id_col1), unique(id_col2))\line   #RM: all_ids <- unique(unlist(lapply(data_list, function(df) as.character(df[[id_col]]))))\line   all_ids <- all_ids[!is.na(all_ids) & all_ids != ""]\line \line   if (length(all_ids) < 2) return(invisible(NULL))\line \line   # 2. String Distance Matrix (Levenshtein)\line   dist_matrix <- stringdist::stringdistmatrix(all_ids, all_ids, method = "lv")\line \line   # Find pairs within the user-adjustable threshold\line   mismatch_indices <- which(dist_matrix > 0 & dist_matrix <= max_dist & upper.tri(dist_matrix), arr.ind = TRUE)\line \line   if (nrow(mismatch_indices) > 0) \{\line     report <- data.frame(\line       id_a = all_ids[mismatch_indices[, 1]],\line       id_b = all_ids[mismatch_indices[, 2]],\line       distance = dist_matrix[mismatch_indices],\line       action_required = "Check if these are the same participant",\line       stringsAsFactors = FALSE\line     )\line \line     # 3. Append to Excel Review Sheet\line     wb <- openxlsx::loadWorkbook(wb_path)\line     sheet_name <- "Review_IDs"\line \line     if (sheet_name %in% names(wb)) openxlsx::removeWorksheet(wb, sheet_name)\line     openxlsx::addWorksheet(wb, sheet_name)\line     openxlsx::writeData(wb, sheet_name, report)\line \line     # Styling for Human-in-the-Loop\line     warn_style <- openxlsx::createStyle(fontColour = "#9C0006", bgFill = "#FFC7CE")\line     openxlsx::conditionalFormatting(wb, sheet_name, cols = 1:ncol(report),\line                                     rows = 2:(nrow(report)+1),\line                                     rule = '!= ""', type = "expression", style = warn_style)\line \line     openxlsx::saveWorkbook(wb, wb_path, overwrite = TRUE)\line     cli::cli_alert_info("ID Audit complete: \{.val \{nrow(report)\}\} potential typos added to \{.file \{sheet_name\}\}.")\line   \}\line \}\line \line #' Final Integrity Check for Tidy Harmonized Data\line #' @description Verifies uniqueness of records and adherence to categorical data contracts.\line #' @param data The final bound tibble.\line #' @param id_col Character. The primary key column (e.g., "pk_hash").\line #' @param time_col Character. The column identifying the time point.\line #' @param verbose Logical. If TRUE, prints a success message. Defaults to TRUE.\line check_integrity <- function(data, id_col, time_col = "timestamp", verbose = TRUE) \{\line   # TO DO: de momento implemento dos checks. Pensar otros que sean pertinentes\line \line   # 1. Tidy data check: unique ID & time\line   duplicates <- duplicated(data[, c(id_col, time_col)])\line   if (any(duplicates)) \{\line     n_dupes <- sum(duplicates)\line     cli::cli_abort(c(\line       "x" = "Integrity failure: non-tidy data detected.",\line       "i" = "\{.val \{n_dupes\}\} duplicate combinations of \{.var \{id_col\}\} and \{.var \{time_col\}\} found.",\line       "!" = "Each participant must have exactly one row per time point."\line     ))\line   \}\line \line   # 2. Factor coding check\line   is_factor_check <- vapply(data, is.factor, logical(1))\line \line   # Check if factor levels are numeric strings\line   for (col in names(data)[is_factor_check]) \{\line     lvls <- levels(data[[col]])\line     if (!all(grepl("^[0-9]+$", lvls))) \{\line       cli::cli_warn("Variable \{.var \{col\}\} is a factor but contains non-numeric labels.")\line     \}\line   \}\line \line   # 3. Conditional success message\line   if (verbose) \{\line     cli::cli_alert_success("Integrity check passed: Data is tidy and fulfills contract requirements.")\line   \}\line   return(invisible(TRUE))\line \}\line \line }